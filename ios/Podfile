# ios/Podfile
#
# This file was missing from the project, which made the Codemagic step
# `cd ios && pod install` fail with "No Podfile found in the project directory".
# It is the standard `flutter create` Podfile, plus the permission_handler
# compile-time switches this app needs.

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# Matches IPHONEOS_DEPLOYMENT_TARGET in ios/Runner.xcodeproj/project.pbxproj
platform :ios, '12.0'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path =
    File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # permission_handler_apple compiles each permission behind a macro.
      # Without these the Bluetooth / Location requests are compiled out and
      # always come back as `PermissionStatus.denied` on iOS.
      definitions = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
      definitions = [definitions] if definitions.is_a?(String)
      definitions += ['PERMISSION_BLUETOOTH=1', 'PERMISSION_LOCATION=1']
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = definitions.uniq

      # Keep every pod at or above the app's deployment target so Xcode 15/16
      # do not fail the build on pods that still declare iOS 11.
      current = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
      if current.nil? || current.to_f < 12.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '12.0'
      end
    end
  end
end
